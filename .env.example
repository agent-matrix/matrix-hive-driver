# matrix-hive-driver configuration

# Driver service
DRIVER_HOST=0.0.0.0
DRIVER_PORT=7000

# Hive Runtime
HIVE_ENDPOINT=http://hive-runtime:8080

# Matrix Architect tool proxy (or Guardian-gated gateway)
TOOL_PROXY_ENDPOINT=http://matrix-architect:9000/tool-proxy

# Evidence storage backend: local|hub|s3|minio
EVIDENCE_SINK=local

# Logging
LOG_LEVEL=info

# LLM provider for local dev/CI verification (optional)
# The main LLM lives in Matrix AI — this is only a local fallback.
# Values: "none" (default) | "ollama"
LLM_PROVIDER=none

# Ollama settings (only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
